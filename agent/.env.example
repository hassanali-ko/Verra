# Agent-only settings, separate from Next.js browser/user-session settings.
OPENAI_API_KEY=
# Optional mounted/private key file instead of a raw environment value:
OPENAI_API_KEY_FILE=
VERRA_MODEL_ID=gpt-5.6-luna
SUPABASE_PRODUCT_URL=
VERRA_WORKER_SERVICE_KEY=
VERRA_AGENT_ENV=production
# On AgentCore, use secret ARNs instead of raw credential environment values.
OPENAI_API_KEY_SECRET_ARN=
VERRA_WORKER_SERVICE_KEY_SECRET_ARN=
# SDK tracing is disabled by the runtime; do not export case content to telemetry.
OTEL_SDK_DISABLED=true
